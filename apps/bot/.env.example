# Discord Bot
DISCORD_TOKEN=YOUR_DISCORD_TOKEN
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_GUILD_ID=YOUR_DISCORD_GUILD_ID

# Interner Server (nur für die API)
BOT_INTERNAL_PORT=3002
BOT_INTERNAL_SECRET=YOUR_BOT_INTERNAL_SECRET

# Datenbank (relativ zu apps/bot, in docker-compose-dev.yml überschrieben)
DATABASE_URL="file:../../packages/database/data.db"

# Lavalink (startet mit "bun run docker:dev", dort überschrieben)
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=dev-password

# Adresse der Website für den Befehl /link (in docker-compose-dev.yml überschrieben)
WEB_SERVER_URL=http://localhost:3000
