# Server
API_SERVER_PORT=3001
WEB_SERVER_URL=http://localhost:3000

# Datenbank (relativ zu apps/api)
DATABASE_URL="file:../../packages/database/data.db"

# Better Auth
BETTER_AUTH_SECRET=YOUR_BETTER_AUTH_SECRET
BETTER_AUTH_URL=http://localhost:3001

# Discord Login
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET

# Discord-Server (Login-Prüfung und Serverdaten)
DISCORD_GUILD_ID=YOUR_DISCORD_GUILD_ID

# Discord-Bot (Serverdaten und Mitgliederliste)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN

# Channel für Meldungen über reduzierte Spiele der Wunschliste
WISHLIST_CHANNEL_ID=YOUR_WISHLIST_CHANNEL_ID

# Interner Bot-Server (Secret muss zum Bot passen)
BOT_INTERNAL_URL=http://127.0.0.1:3002
BOT_INTERNAL_SECRET=YOUR_BOT_INTERNAL_SECRET
