# Lokal aus apps/api/.env erzeugt. Auf dem Server eigene Werte und HTTPS-Adressen verwenden.
WEB_SERVER_URL=YOUR_SERVER_URL
BETTER_AUTH_URL=YOUR_BETTER_AUTH_URL
BETTER_AUTH_SECRET=YOUR_BETTER_AUTH_SECRET
BOT_INTERNAL_SECRET=YOUR_BOT_INTERNAL_SECRET
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
DISCORD_GUILD_ID=YOUR_DISCORD_GUILD_ID
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
# Channel für Meldungen über reduzierte Spiele der Wunschliste.
WISHLIST_CHANNEL_ID=YOUR_WISHLIST_CHANNEL_ID
LAVALINK_PASSWORD=YOUR_LAVALINK_PASSWORD
YT_CIPHER_TOKEN=YOUR_YT_CIPHER_TOKEN

# Optional: nur setzen, wenn YouTube die IP des Servers blockiert ("Sign in to confirm you're not a bot").
# YOUTUBE_OAUTH_ENABLED=true
# YOUTUBE_OAUTH_REFRESH_TOKEN=YOUR_REFRESH_TOKEN
