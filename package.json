{
  "name": "Bonsai Bot",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint",
    "format": "oxfmt .",
    "check-types": "turbo run check-types",
    "db:studio": "cd packages/database && bunx prisma studio",
    "db:generate": "turbo run db:generate",
    "db:migrate": "cd packages/database && bunx prisma migrate dev",
    "db:migrate:reset": "cd packages/database && bunx prisma migrate reset --force",
    "docker": "docker compose -f docker-compose.yml up --build -d",
    "format:check": "oxfmt --check .",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "prettier": "3.9.6",
    "prisma": "^7.10.1",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "7",
    "dotenv": "^18.0.9",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0"
  }
}
