{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "singleQuote": false,
  "sortPackageJson": false,
  "sortImports": {
    "internalPattern": ["~/", "@/", "@repo/"],
    "newlinesBetween": true,
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ]
  },
  "ignorePatterns": ["**/generated/**", "**/.next/**", "**/dist/**"]
}
